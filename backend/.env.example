OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-image-1
CUSTOM_API_KEY=
CUSTOM_PROVIDER_NAME=兼容接口
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=gpt-image-1
WECOM_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=
SMTP_SENDER=your-account@gmail.com
ADMIN_EMAILS=admin@example.com
GENERATION_MAX_CONCURRENCY=4
GENERATION_MAX_ACTIVE_TASKS=32
GENERATION_MAX_TASKS_PER_USER=4
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_COOLDOWN_SECONDS=60
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_VERIFICATION_MAX_REQUESTS_PER_IP=10
AUTH_VERIFICATION_GLOBAL_MAX_REQUESTS=100
AUTH_VERIFICATION_WINDOW_SECONDS=600

# Independent video keys are configured in the UI, not in these storage settings.
VIDEO_API_BASE_URL=https://direct.beibeihai.xyz
VIDEO_PUBLIC_BASE_URL=
# Persist a randomly generated 32+ character signing secret across restarts.
VIDEO_ASSET_SIGNING_SECRET=
VIDEO_POLL_INTERVAL=3
VIDEO_MAX_WAIT=1200
VIDEO_MAX_CONCURRENCY=2
VIDEO_MAX_TASKS_PER_USER=2
VIDEO_MAX_ACTIVE_TASKS=32
VIDEO_RESULT_MAX_BYTES=536870912
# One shared private R2 bucket; never send these credentials to the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_KEY_PREFIX=pictora/videos/
COOKIE_SECURE=false

# Optional image archival (separate from video storage; local BLOB fallback is retained).
# Production may keep these values and shared R2 credentials in private .env.r2.
R2_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=pictora/generated
